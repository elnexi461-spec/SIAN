# JD Scraper Configuration
# Copy this file to .env and fill in your values

# Concurrency and Rate Limiting
CONCURRENCY=16
REQUEST_RATE=50
MAX_RETRIES=3
REQUEST_TIMEOUT=15000
CONNECTION_TIMEOUT=5000

# Session Management
SESSION_ROTATION=100

# Batch and Output
BATCH_SIZE=100
OUTPUT_FORMAT=jsonl

# Geographic Area (JD area code format: province_city_district_street)
JD_AREA_ID=1_2901_55554_0

# Proxy Pool (comma-separated list of proxy URLs)
# Format: http://user:pass@host:port or http://host:port
PROXY_POOL=

# Storage
DATABASE_URL=sqlite:./data/scraper.db
CHECKPOINT_INTERVAL=60

# Redis (optional, for distributed queue)
REDIS_URL=
QUEUE_NAME=jd-scraper-queue

# JD Base URL
JD_BASE_URL=https://item.jd.com

# User Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Taobao Browserbase fallback
# Keep this value in Replit Secrets, not in source control.
BROWSERBASE_API_KEY=
TAOBAO_HUMAN_TIMEOUT_MS=600000

# Logging
LOG_LEVEL=info
